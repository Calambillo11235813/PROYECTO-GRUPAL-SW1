# Django / Base
# Copia este archivo a ".env" y ajusta valores para tu entorno local.

# Seguridad
SECRET_KEY=pon-aqui-una-secret-key-segura
DEBUG=True

# Base de datos (usa 5435 si corres con docker-compose del repo)
POSTGRES_DB=proyecto_sw1
POSTGRES_USER=sw1_user
POSTGRES_PASSWORD=sw1_password
DB_HOST=localhost
DB_PORT=5435

# CORS (solo desarrollo)
# Agrega orígenes del frontend si no usas CORS_ALLOW_ALL_ORIGINS
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Detector de Código (módulo codigo)
# Si no tienes pesos locales de HF en Backend/codigo/modelo_ia,
# puedes forzar el fallback seguro para evitar errores 500.
CODE_DETECTOR_FORCE_FALLBACK=1
